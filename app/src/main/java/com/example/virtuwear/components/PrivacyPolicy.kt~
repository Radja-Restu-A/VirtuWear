package com.example.virtuwear.components

import androidx.compose.foundation.background
import androidx.compose.foundation.border
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.draw.clip
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.unit.dp
import androidx.compose.ui.window.Dialog
import androidx.compose.ui.window.DialogProperties

@Composable
fun PrivacyPolicy(
    showPrivacy: Boolean,
    onDismiss: () -> Unit,
    onAccept: (Boolean) -> Unit,
    showCheckboxAndButton: Boolean = true // New parameter with default value true
) {
    if (showPrivacy) {
        Dialog(
            onDismissRequest = onDismiss,
            properties = DialogProperties(
                dismissOnBackPress = true,
                dismissOnClickOutside = true
            )
        ) {
            var isChecked by remember { mutableStateOf(false) }

            Box(
                modifier = Modifier
                    .width(350.dp)
                    .height(520.dp)
                    .clip(RoundedCornerShape(16.dp))
                    .background(Color.White)
                    .border(
                        width = 1.dp,
                        color = Color.Gray,
                        shape = RoundedCornerShape(16.dp)
                    )
                    .padding(12.dp)
            ) {
                Box(
                    modifier = Modifier
                        .fillMaxSize()
                        .border(
                            width = 2.dp,
                            color = Color.LightGray,
                            shape = RoundedCornerShape(12.dp)
                        )
                        .padding(16.dp)
                ) {
                    Column(
                        modifier = Modifier
                            .fillMaxSize()
                            .verticalScroll(rememberScrollState()),
                        horizontalAlignment = Alignment.Start
                    ) {
                        Text(
                            text = "Privacy Policy",
                            style = MaterialTheme.typography.titleLarge,
                            modifier = Modifier.align(Alignment.CenterHorizontally)
                        )

                        Spacer(modifier = Modifier.height(12.dp))

                        Text(
                            text = """
                                Kebijakan Privasi
                        
                                Aplikasi VirtuWear menghargai dan melindungi privasi Anda. Kebijakan privasi ini menjelaskan bagaimana kami mengumpulkan, menggunakan, dan melindungi informasi pribadi Anda saat menggunakan aplikasi virtual try-on ini.
                        
                                1. Informasi yang Dikumpulkan
                                Kami dapat mengumpulkan data pribadi seperti nama, alamat email, dan citra wajah melalui kamera perangkat Anda hanya untuk keperluan fitur virtual try-on. Data ini tidak akan disimpan di server kami dan hanya diproses secara lokal di perangkat Anda.
                        
                                2. Penggunaan Data
                                Data yang dikumpulkan digunakan semata-mata untuk:
                                - Menyediakan pengalaman virtual try-on secara real-time.
                                - Meningkatkan akurasi dan kenyamanan fitur dalam aplikasi.
                        
                                3. Penyimpanan & Keamanan
                                Kami tidak menyimpan citra wajah atau informasi pribadi di server. Semua pemrosesan dilakukan secara lokal, dan kami tidak membagikan data Anda kepada pihak ketiga.
                        
                                4. Persetujuan Pengguna
                                Dengan menggunakan aplikasi ini, Anda memberikan izin kepada aplikasi untuk mengakses kamera perangkat Anda. Anda dapat menolak atau membatasi akses kapan saja melalui pengaturan perangkat Anda.
                        
                                5. Perubahan Kebijakan
                                Kebijakan privasi ini dapat diperbarui dari waktu ke waktu. Anda akan diberitahu apabila terjadi perubahan signifikan terkait penggunaan informasi Anda.
                        
                                Dengan mencentang kotak di bawah ini dan melanjutkan, Anda menyetujui seluruh isi kebijakan privasi ini.
                            """.trimIndent(),
                            style = MaterialTheme.typography.bodyMedium
                        )

                        Spacer(modifier = Modifier.height(16.dp))

                        if (showCheckboxAndButton) {
                            Row(verticalAlignment = Alignment.CenterVertically) {
                                Checkbox(
                                    checked = isChecked,
                                    onCheckedChange = { isChecked = it }
                                )
                                Text(text = "I Understand and Agree")
                            }

                            Spacer(modifier = Modifier.height(16.dp))

                            Button(
                                onClick = {
                                    onAccept(isChecked)
                                    onDismiss()
                                },
                                enabled = isChecked,
                                colors = ButtonDefaults.buttonColors(
                                    containrColor = if (isChecked) Color.Black else Color.Gray,
                                    contentColor
                                ),
                                modifier = Modifier
                                    .align(alignment = Alignment.CenterHorizontally)
                            ) {
                                Text("Agree")
                            }
                        }
                    }
                }
            }
        }
    }
}